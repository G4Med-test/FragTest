/physics/addPhysics QGSP_BIC_EMY
/FragTest/phantomThickness 59 mm
/run/initialize

/control/verbose 0

/gps/particle ion
/gps/ion 6 12 6

#Rotate beam to be shot onto the xz plane
/gps/pos/rot1 1 0 0
/gps/pos/rot2 0 0 1

/gps/pos/shape Circle
/gps/pos/type Beam
/gps/pos/radius 0. mm
/gps/pos/sigma_r 2.123 mm

/gps/pos/centre 0. 200 0. cm
/gps/direction 0 -1 0

/gps/ene/type Gauss
/gps/ene/mono 4800.0 MeV
/gps/ene/sigma 7.200 MeV

/tracking/verbose 0
/run/beamOn 100000
