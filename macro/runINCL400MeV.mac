/control/execute physicsINCL.mac
/run/initialize
/control/verbose 0

#/gps/particle geantino
/gps/particle ion
/gps/ion 6 12 6

#Rotate beam to be shot onto the xz plane 
/gps/pos/rot1 1 0 0
/gps/pos/rot2 0 0 1


/gps/pos/shape Circle
/gps/pos/type Beam
/gps/pos/radius 0. mm
/gps/pos/sigma_r 2.123 mm

/gps/pos/centre 0. 200. 0. cm
/gps/direction 0 -1 0


/gps/ene/type Gauss
/control/alias energyPerNucleon 400. #change the energy per nucleon by changing this value
/control/multiply totalEnergy {energyPerNucleon} 12.
/gps/ene/mono {totalEnergy} MeV

/control/multiply energySigma {totalEnergy} 0.0015 #the energy sigma of the beam (0.01 = 1%)
/gps/ene/sigma {energySigma} MeV

/tracking/verbose 0
/run/beamOn 1000000

